#!/bin/sh

# Source the .env file if it exists (production secrets)
if [ -f "$RELEASE_ROOT/../../.env" ]; then
  set -a
  . "$RELEASE_ROOT/../../.env"
  set +a
fi

# Derive the distributed node name per host. A shared .env used to hardcode
# RELEASE_NODE on every worker, so they all booted with the same name and
# only one could join the cluster.
export RELEASE_DISTRIBUTION=name
WG_IP="$(ip -4 -o addr show wg0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)"
[ -z "$WG_IP" ] && WG_IP="$(hostname -I | awk '{print $1}')"
case "${LS_ROLE:-worker}" in
  master) export RELEASE_NODE="master@${WG_IP}" ;;
  *)      export RELEASE_NODE="worker_$(hostname -s | tr -cd 'a-zA-Z0-9')@${WG_IP}" ;;
esac

# Erlang distribution and epmd listen on the WireGuard address only
# (security audit, 2026-09-09). Both listened on 0.0.0.0 before, protected
# by nothing but the iptables DROP rule, and that rule has already failed
# once in this fleet's history (the NAT-before-filter incident that left
# :4000 open). Anyone reaching a dist port with the cookie has a shell on
# every node. The mesh already talks over wg0, so nothing changes for the
# cluster; epmd keeps answering on loopback as well, which `bin/ls rpc`
# relies on. The tuple form is what the kernel flag expects: 10.0.0.1
# becomes {10,0,0,1}.
export ERL_EPMD_ADDRESS="$WG_IP"
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_use_interface {$(echo "$WG_IP" | tr . ,)}"
