
<main class="pt-[120px] pb-20">
  <div class="mx-auto max-w-[600px] px-6 text-center">
    <h1 class="font-display text-2xl font-bold mb-4">This page is outdated</h1>
    <p class="text-white/60 mb-6">Please clear your browser cache or click below to reload.</p>
    <a href={"/store/#{@slug}?_=#{System.system_time(:second)}"} class="inline-flex rounded-xl bg-accent px-6 py-3 font-display text-sm font-semibold text-white hover:bg-accent-hover">
      Reload store page
    </a>
  </div>
</main>
<footer class="border-t border-white/[0.07] py-8 text-center text-[13px] text-white/35">&copy; 2026 ListSignal</footer>
