<main class="pt-[140px] pb-20"><div class="mx-auto max-w-[480px] px-6 text-center">
  <%= if @status == :ok do %>
    <div class="text-4xl mb-4">&#128075;</div>
    <h1 class="font-display text-2xl font-bold mb-3">You're unsubscribed</h1>
    <p class="text-white/60 text-[15px] leading-relaxed">No more weekly digests. Your account and searches are untouched, and you can turn the digest back on any time from your dashboard.</p>
    <p class="text-white/40 text-[13px] mt-6">Changed your mind, or was something wrong with the emails? Reply to any of them, they reach me directly. &mdash; Will</p>
  <% else %>
    <div class="text-4xl mb-4">&#129300;</div>
    <h1 class="font-display text-2xl font-bold mb-3">That link didn't work</h1>
    <p class="text-white/60 text-[15px] leading-relaxed">It may be very old or incomplete. Email <a href="mailto:will@listsignal.com" class="text-accent hover:underline">will@listsignal.com</a> and I'll unsubscribe you by hand.</p>
  <% end %>
</div></main>
