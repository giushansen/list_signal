<main class="pt-[140px] pb-20"><div class="mx-auto max-w-[1200px] px-6">
  <div class="text-center max-w-[600px] mx-auto mb-8">
    <h1 class="font-display text-[clamp(32px,4vw,48px)] font-bold tracking-tight leading-[1.1] mb-4">Simple. No credits.<br/>No surprises.</h1>
    <p class="text-lg text-white/60">Flat-rate plans with predictable limits. No expiring tokens, no per-lookup fees.</p>
  </div>

  <%!-- Monthly / Annual toggle --%>
  <div class="flex items-center justify-center gap-3 mb-10">
    <span id="label-monthly" class="text-sm font-medium text-white">Monthly</span>
    <button id="billing-toggle" type="button" role="switch" aria-checked="false"
      class="relative inline-flex h-7 w-[52px] items-center rounded-full bg-white/[0.08] transition-colors cursor-pointer"
      onclick="toggleBilling()">
      <span id="toggle-dot" class="inline-block h-5 w-5 rounded-full bg-white shadow transform transition-transform translate-x-1"></span>
    </button>
    <span id="label-annual" class="text-sm font-medium text-white/40">
      Annual
      <span class="ml-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-accent/15 text-accent">Save 20%+</span>
    </span>
  </div>

  <div class="grid md:grid-cols-3 gap-6 max-w-[1000px] mx-auto mb-10">
    <%!-- Free column --%>
    <div class="rounded-[20px] border border-white/[0.07] bg-white/[0.03] p-9">
      <div class="font-display text-[15px] font-semibold text-white/60 mb-1.5">Free</div>
      <div class="font-display text-[48px] font-extrabold tracking-[-2px] leading-none mb-1">$0</div>
      <div class="text-[13px] text-white/35 mb-6">Free forever</div>
      <ul class="space-y-2.5 mb-8">
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-accent font-bold mt-px">&#10003;</span> Browse all domain data</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-accent font-bold mt-px">&#10003;</span> 15 results per page</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-accent font-bold mt-px">&#10003;</span> 10 searches per minute</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-accent font-bold mt-px">&#10003;</span> Tech + country filters</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/40"><span class="text-white/20 font-bold mt-px">&#10005;</span> No CSV export</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/40"><span class="text-white/20 font-bold mt-px">&#10005;</span> No contact emails</li>
      </ul>
      <a href="/signup" class="block w-full text-center rounded-xl border border-white/[0.07] py-3.5 font-display text-sm font-semibold text-white hover:border-white/20 transition">Get Started Free</a>
    </div>

    <%!-- Starter column --%>
    <div class="rounded-[20px] border border-blue-500/40 bg-white/[0.03] p-9 relative shadow-[0_0_50px_rgba(59,130,246,0.1)]">
      <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-blue-500 text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider font-display">Best Value</div>
      <div class="font-display text-[15px] font-semibold text-blue-400 mb-1.5">Starter</div>
      <div class="font-display text-[48px] font-extrabold tracking-[-2px] leading-none mb-1" data-monthly="$39" data-annual="$29">$39</div>
      <div class="text-[13px] text-white/35 mb-1" data-period-monthly="per month &middot; cancel anytime" data-period-annual="per month &middot; billed annually ($348/yr)">per month &middot; cancel anytime</div>
      <div data-savings class="hidden text-[12px] text-accent font-semibold mb-4">Save $120/yr</div>
      <div class="mb-6"></div>
      <ul class="space-y-2.5 mb-8">
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-blue-400 font-bold mt-px">&#10003;</span> All filters unlocked</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-blue-400 font-bold mt-px">&#10003;</span> 5,000 rows / month</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-blue-400 font-bold mt-px">&#10003;</span> 50 results per page</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-blue-400 font-bold mt-px">&#10003;</span> 30 searches per minute</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-blue-400 font-bold mt-px">&#10003;</span> Contact email access</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-blue-400 font-bold mt-px">&#10003;</span> Email support</li>
      </ul>
      <a data-href-monthly="/signup?plan=starter&billing=monthly" data-href-annual="/signup?plan=starter&billing=annual" href="/signup?plan=starter&billing=monthly" class="block w-full text-center rounded-xl bg-blue-500 py-3.5 font-display text-sm font-semibold text-white shadow-[0_8px_28px_rgba(59,130,246,0.25)] hover:bg-blue-400 transition">Start with Starter</a>
    </div>

    <%!-- Pro column --%>
    <div class="rounded-[20px] border border-accent bg-white/[0.03] p-9 relative shadow-[0_0_50px_rgba(16,185,129,0.15)]">
      <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-accent text-white px-4 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider font-display">Most Popular</div>
      <div class="font-display text-[15px] font-semibold text-emerald-400 mb-1.5">Pro</div>
      <div class="font-display text-[48px] font-extrabold tracking-[-2px] leading-none mb-1" data-monthly="$99" data-annual="$79">$99</div>
      <div class="text-[13px] text-white/35 mb-1" data-period-monthly="per month &middot; cancel anytime" data-period-annual="per month &middot; billed annually ($948/yr)">per month &middot; cancel anytime</div>
      <div data-savings class="hidden text-[12px] text-accent font-semibold mb-4">Save $240/yr</div>
      <div class="mb-6"></div>
      <ul class="space-y-2.5 mb-8">
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-accent font-bold mt-px">&#10003;</span> Everything in Starter, plus:</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-accent font-bold mt-px">&#10003;</span> 50,000 rows / month</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-accent font-bold mt-px">&#10003;</span> 100 results per page</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-accent font-bold mt-px">&#10003;</span> 120 searches per minute</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-accent font-bold mt-px">&#10003;</span> Priority email support</li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-accent font-bold mt-px">&#10003;</span> API access <span class="ml-1.5 inline-flex px-1.5 py-0.5 rounded text-[9px] uppercase tracking-wider bg-white/[0.06] text-white/30 font-medium">Soon</span></li>
        <li class="flex items-start gap-2.5 text-[13.5px] text-white/60"><span class="text-accent font-bold mt-px">&#10003;</span> Webhook alerts <span class="ml-1.5 inline-flex px-1.5 py-0.5 rounded text-[9px] uppercase tracking-wider bg-white/[0.06] text-white/30 font-medium">Soon</span></li>
      </ul>
      <a data-href-monthly="/signup?plan=pro&billing=monthly" data-href-annual="/signup?plan=pro&billing=annual" href="/signup?plan=pro&billing=monthly" class="block w-full text-center rounded-xl bg-accent py-3.5 font-display text-sm font-semibold text-white shadow-[0_8px_28px_rgba(16,185,129,0.25)] hover:bg-accent-hover transition">Upgrade to Pro</a>
    </div>
  </div>

  <%!-- Proof strip: real numbers, stated verifiably. Social proof without
       invention — the dataset itself is the credential, plus who it is for
       and risk reversal. --%>
  <div class="max-w-[1000px] mx-auto mb-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center mb-6">
      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
        <div class="font-display text-[26px] font-extrabold tracking-tight">9.6M+</div>
        <div class="text-[11px] uppercase tracking-wider text-white/35 font-medium">Businesses tracked</div>
      </div>
      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
        <div class="font-display text-[26px] font-extrabold tracking-tight">2M+</div>
        <div class="text-[11px] uppercase tracking-wider text-white/35 font-medium">Products &amp; price points</div>
      </div>
      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
        <div class="font-display text-[26px] font-extrabold tracking-tight">250K+</div>
        <div class="text-[11px] uppercase tracking-wider text-white/35 font-medium">Contact addresses</div>
      </div>
      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
        <div class="font-display text-[26px] font-extrabold tracking-tight">Hourly</div>
        <div class="text-[11px] uppercase tracking-wider text-white/35 font-medium">New stores detected</div>
      </div>
    </div>
    <p class="text-center text-[13.5px] text-white/50 leading-relaxed max-w-[640px] mx-auto">
      Built for <span class="text-white/80">Shopify app vendors</span> finding stores that need them,
      <span class="text-white/80">agencies</span> pitching with evidence instead of guesses, and
      <span class="text-white/80">lead-gen teams</span> who need fresh lists, not last quarter&#8217;s database.
    </p>
    <p class="text-center text-[12px] text-white/35 mt-3">
      Cancel anytime &middot; no credits or expiring tokens &middot; payments secured by Stripe &middot; start free, no card required
    </p>
  </div>

  <%!-- One-off CSV --%>
  <div class="mt-10 p-7 rounded-2xl border border-white/[0.07] bg-white/[0.02] max-w-[1000px] mx-auto">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-5">
      <div class="max-w-[560px]">
        <div class="font-display text-[15px] font-semibold text-white/80 mb-1.5">One-off list &mdash; no subscription</div>
        <p class="text-[13.5px] text-white/55 leading-relaxed">
          Tell us the segment you want &mdash; platform, country, size, tech stack, catalogue size &mdash;
          and we build the list and send it as a CSV. Contact addresses included where published.
          Yours to keep, one payment, no account needed.
        </p>
        <p class="text-[12.5px] text-white/35 mt-2">
          Licensed for use inside your own organisation. Not for resale or redistribution.
        </p>
      </div>
      <div class="text-center md:text-right shrink-0">
        <div class="font-display text-[40px] font-extrabold tracking-[-1.5px] leading-none">$199</div>
        <div class="text-[12.5px] text-white/40 mt-1 mb-3">per list, one-time</div>
        <a href="mailto:will@listsignal.com?subject=One-off%20list%20request" class="inline-block rounded-xl border border-white/15 px-6 py-3 font-display text-sm font-semibold text-white hover:bg-white/[0.06] transition">Request a list &#8594;</a>
      </div>
    </div>
  </div>

  <%!-- Enterprise anchor --%>
  <div class="text-center mt-10 p-6 rounded-2xl border border-white/[0.05] bg-white/[0.02] max-w-[1000px] mx-auto mb-10">
    <p class="text-sm text-white/50">
      <span class="font-semibold text-white">Need more?</span>
      Enterprise plans with custom limits, bulk API, and team seats.
      <a href="mailto:will@listsignal.com" class="text-accent hover:underline ml-1">Contact us &#8594;</a>
    </p>
  </div>

  <%!-- Competitive comparison strip --%>
  <div class="text-center mb-20">
    <p class="text-sm text-white/40">What others charge $250/mo to export, ListSignal includes at $39.</p>
  </div>
</div>

<script>
function toggleBilling() {
  var toggle = document.getElementById('billing-toggle');
  var dot = document.getElementById('toggle-dot');
  var isAnnual = toggle.getAttribute('aria-checked') === 'true';
  var newState = !isAnnual;

  toggle.setAttribute('aria-checked', String(newState));
  dot.classList.toggle('translate-x-1', !newState);
  dot.classList.toggle('translate-x-[27px]', newState);

  document.getElementById('label-monthly').classList.toggle('text-white/40', newState);
  document.getElementById('label-monthly').classList.toggle('text-white', !newState);
  document.getElementById('label-annual').classList.toggle('text-white/40', !newState);
  document.getElementById('label-annual').classList.toggle('text-white', newState);

  // Swap prices
  document.querySelectorAll('[data-monthly]').forEach(function(el) {
    el.textContent = newState ? el.dataset.annual : el.dataset.monthly;
  });

  // Swap period text
  document.querySelectorAll('[data-period-monthly]').forEach(function(el) {
    el.textContent = newState ? el.dataset.periodAnnual : el.dataset.periodMonthly;
  });

  // Swap CTA hrefs
  document.querySelectorAll('[data-href-monthly]').forEach(function(el) {
    el.href = newState ? el.dataset.hrefAnnual : el.dataset.hrefMonthly;
  });

  // Show/hide savings badges
  document.querySelectorAll('[data-savings]').forEach(function(el) {
    el.classList.toggle('hidden', !newState);
  });
}
</script>
</main>
<footer class="border-t border-white/[0.07] py-10 text-center text-[13px] text-white/35">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="mb-3">
      <a href="/features" class="text-white/50 hover:text-white transition-colors mx-3">Features</a>
      <a href="/pricing" class="text-white/50 hover:text-white transition-colors mx-3">Pricing</a>
      <a href="/new-stores" class="text-white/50 hover:text-white transition-colors mx-3">New Stores</a>
      <a href="/privacy" class="text-white/50 hover:text-white transition-colors mx-3">Privacy</a>
      <a href="/terms" class="text-white/50 hover:text-white transition-colors mx-3">Terms</a>
    </div>
    <p>&copy; 2026 ListSignal</p>
  </div>
</footer>
