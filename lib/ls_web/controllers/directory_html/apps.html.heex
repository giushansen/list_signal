<main class="pt-[100px] pb-20"><div class="mx-auto max-w-[1200px] px-6">
  <h1 class="font-display text-[clamp(28px,4vw,40px)] font-bold tracking-tight mb-4">Shopify App & Technology Directory</h1>
  <p class="text-lg text-white/60 mb-10 max-w-[600px]">Browse <%= length(@techs) %> technologies and apps detected across Shopify stores. Click any app to see which stores use it.</p>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
    <%= for tech <- @techs do %>
      <a href={"/tech/#{tech.name |> String.downcase() |> String.replace(~r/[^a-z0-9]+/, "-") |> String.trim("-")}"} class="flex items-center justify-between rounded-xl border border-white/[0.07] bg-white/[0.02] px-4 py-3 hover:border-accent/25 hover:bg-accent/[0.03] transition-all group">
        <span class="text-sm text-white/80 group-hover:text-accent font-medium truncate"><%= tech.name %></span>
        <span class="text-xs text-white/30 ml-2 shrink-0"><%= tech.count %></span>
      </a>
    <% end %>
  </div>
</div></main>
<footer class="border-t border-white/[0.07] py-8 text-center text-[13px] text-white/35">&copy; 2026 ListSignal</footer>